# --- AWS (local development only; on EC2 the instance IAM role is used) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
 
# --- LLM: Groq is primary, local Ollama is the fallback ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
 
# --- Agent behaviour ---
POLL_INTERVAL_SECONDS=21600
BASELINE_DAILY_USD=1.00
LOOKBACK_DAYS=7
SIMULATE_ANOMALY=false
REPORT_DIR=reports
 
# --- Deployment ---
GRAFANA_ADMIN_PASSWORD=change-me
DOCKER_IMAGE=costwatch-agent:local
